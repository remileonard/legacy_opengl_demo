
#
# Directory information on where to look for models & textures
#
path "./:./data/models:./data/textures:./data/sounds:./data/fonts";

#
# Screen Definitions 
#

#process app cull draw isect;
#process app cull draw;
process appculldraw;
#cpu 1 app isolate;
#cpu 2 cull isolate;
#cpu 3 draw isolate;
#cpu 4 isect isolate;

framerate 60.0;
#phase LOCK;

pipe "pipe0" add on screen 0,
		viewport 0,1279,0,1023;

#
# Key Press/Release Function Bindings 
#
# qdev "WKEY" function "wireframeToggle";

# remember to set the environment variables:
# setenv FBPORT /dev/ttydx
#                          where x is the serial port #
# setenv FPTYPE BeeBox

qdev "WKEY" function "wireframeToggle";
qdev "SKEY" function "statsToggle";
qdev "TKEY" function "textureToggle";
qdev "HKEY" function "help";

qdev "BKEY" function "toggleBeeBox";
qdev "FKEY" function "toggleWingman";
qdev "LEFTALTKEY" function "explodeLeftMissile";
qdev "RIGHTALTKEY" function "explodeRightMissile";
# qdev "SKEY" function "saveRec";
qdev "NKEY" function "noSpeeding";
# qdev "MKEY" function "eyeMissile";
qdev "EKEY" function "eyeFlight";
qdev "PKEY" function "watchEnemy";
qdev "CKEY" function "cheatMissile";
qdev "RKEY" function "toggleHud";
qdev "UPARROWKEY" function "plusRadar", autorepeat;
qdev "DOWNARROWKEY" function "minusRadar", autorepeat;
qdev "SPACEKEY" function "restartFlight";


module "cool weathers" add,
  preinit "esInitEnv",
  postapp "esUpdateEnv",
  predraw "esDrawEnv" ;

module "eyestuff" add, preinit. "eyeStuff";
module "Trails Init" add, preinit. "initTrails" ;
module "Fumes Init" add, preinit "initFumes";
module "Smoke Init" add, preinit. "initSmoke";

configure;

# objects
#

object "camera" load "eye.dwb";

object "ground" loadstatic "new_terrain.dwb";
object "ground" type terrain;

object "f18" load "f18.dwb" isectGeom "f18_i.drt" mask 0xffffffff;
object "Enemy0" load "f18.dwb" isectGeom "f18_i.drt" mask 0xffffffff;
object "Enemy1" load "f18.dwb" isectGeom "f18_i.drt" mask 0xffffffff;
object "Enemy2" load "f18.dwb" isectGeom "f18_i.drt" mask 0xffffffff;
object "Enemy3" load "Mig27.dwb" isectGeom "Mig27_i.dwb" mask 0xffffffff;
object "Enemy4" load "Mig27.dwb" isectGeom "Mig27_i.dwb" mask 0xffffffff;

object "Broken0" load "Broken0.dwb";
object "Broken1" load "Broken1.dwb";
object "Broken2" load "Broken2.dwb";
object "Broken3" load "Broken3.dwb";
object "Broken4" load "Broken4.dwb";

#object "f18hud" load "f18hud.drt"; 

channel "pipe0chan0" add on pipe "pipe0";
channel "pipe0chan0" viewport 0.00 1.0 0.00 1.00,
		    clip 10.00, 30000.00,
		    fov 50.00 -1.00,
		    fadeLOD;
#		    window -0.50, 0.50, -0.31, 0.31;
#		    viewpos 0.00 0.00 0.00,
#		    viewrot 0.00 0.00 0.00,
channel "pipe0chan0" attach "camera";

# Modules 
#
module "updateHudValues" add, preapp "updateHudValues";
module "drt" add, postinit. "initAnimation", postapp "updateAnimation";

module "initWeather" add postinit "initWeather";
module "PrepageEffects" add, postinit. "initEffects";
module "start" add, postinit. "initFlight" ;
module "updateSmoke" add, preapp "updateSmoke";
module "drawSmoke" add, postrender "drawSmoke";
module "f18 audio" add, postinit "initAudio", postapp "controlAudio";

userCallback "setFadeDistance" argument "750.0";

%ifdef MORRIS
# setup the hostname before the postinit module is called.
usercb "cbHostname" argument "smorgum 2000 f18";
usercb "cbBroadcastPacket" argument "0";

module "network stuff" add, 
  postinit "setupNetworkProc", 
  preapp "syncNetworkProc";
#endif
%endif
