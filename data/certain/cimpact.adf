// Vega Application Definition File

system {
	notify	fatal;
	mpmode	0;
	appcpu	-1;
	apppri	-1;
	isectcpu	-1;
	isectpri	-1;
	syscpu	-1;
	framerate	30;
	phase	lock;
	fperror	on;
	exitkey	0;
	awnotify	fatal;
	awmpmode	off;
	imgcpu	-1;
	imgpri	-1;
	audioEnabled	off;
}


path {
	pathname	../data/audio_data/;
}


channel Main {
	window	Main;
	viewport	0	1	0	1;
	nearfar	4	3500;
	clear	1	1	0	0;
	fov	45	-1;
	gfx	default;
	clearclr	1	1	1;
	skew	0	0	0	0	0	0;
}


channel CockPit {
	window	Main;
	viewport	0	1	0	1;
	nearfar	1	20;
	clear	0	0	0	0;
	fov	45	36;
	skew	0	0	0	0	0	0;
}


gfx default {
	texture	on;
	lighting	on;
	fog	on;
	transparency	on;
	zbuffer	on;
	backface	off;
	fade	on;
	faderange	50;
	lodscale	1;
	frontface	on;
}


gfx CockPit {
	texture	on;
	lighting	off;
	fog	off;
	transparency	on;
	zbuffer	off;
	backface	off;
	fade	off;
	faderange	100;
	lodscale	1;
	frontface	on;
}


object Terrain {
	file	terrain.fst;
	loader	0;
	loaderflags	0x0	255;
	convt	2;
	cs	0;
	optim	0x0;
	isclass	0x1;
	divisions	10;
	upvol	on;
	parts	on;
	autorange	-1;
	pos	0	0	0	0	0	0;
	represent	0x0;
	temp	-1;
	parttemp	""	0	-1;
	dis	off;
	capabilities	0x0;
	entityid	0	0	0	0	0	0	0	0;
	markings	0	"";
	appear	0x0;
	deadrec	0;
	tflod_state	on;
	tflod_depth	1;
	immediate	1;
	tflod_fortype	0;
	tflod_elevscale	disable;
	triggerFltSounds	off;
	recvEnabled	off;
	entitytypeid	0	0	0	0	0	0	0;
	enableFltSounds	off;
}


